{
  "name": "@minamorl/markdown-next",
  "description": "Markdown parser with Aozora bunko ruby support and HTML passthrough",
  "main": "./lib/src/parser.js",
  "types": "./lib/src/parser.d.ts",
  "scripts": {
    "build": "tsc",
    "example": "cd examples && webpack",
    "prepublish": "pnpm run build",
    "test": "pnpm run build && mocha lib/test && node --test test/readme.test.cjs test/security.test.cjs",
    "test:characterization": "npm run build && node test/characterization/run.cjs && node --test test/characterization/harness.test.cjs && node bench/followup/security-golden.cjs && node bench/prepublish/verify-attributes.cjs",
    "characterization:freeze": "npm run build && node test/characterization/freeze.cjs",
    "bench": "npm run build && node bench/run.cjs",
    "bench:verify": "node bench/verify.cjs",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "test:readme": "npm run build && node --test test/readme.test.cjs"
  },
  "author": "minamorl",
  "license": "MIT",
  "files": [
    "lib/src/",
    "LICENSE"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.5.0",
    "@types/power-assert": "^1.5.12",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.1.0",
    "mocha": "^11.7.5",
    "power-assert": "^1.6.1",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.2",
    "react": "19.2.4",
    "@types/react": "19.2.14"
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minamorl/markdown-next.git"
  },
  "bugs": {
    "url": "https://github.com/minamorl/markdown-next/issues"
  },
  "homepage": "https://github.com/minamorl/markdown-next#readme",
  "version": "2.3.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
